---
import BrandLogo from './BrandLogo.astro';
import ClampedLinkList from './ClampedLinkList.astro';
import Link from './Link.astro';
import { appUrls } from '../config/appUrls.js';
import '../styles/home-navigation-header.css';
---

<header class="home-header">
	<BrandLogo />

	<nav aria-label="Main navigation">
		<ClampedLinkList>
			<Link href="#features">Features</Link>
			<Link href="#notes">Notes</Link>
			<Link href="https://github.com/Messafy/frontend" target="_blank">GitHub</Link>
		</ClampedLinkList>
	</nav>

	<a class="home-header__cta" href={appUrls.login}>
		<span class="button button--primary">Sign in</span>
	</a>
</header>

<script>
	const header = document.querySelector('.home-header');

	const updateHeader = () => {
		header?.classList.toggle('home-header--scrolled', window.scrollY > 20);
	};

	updateHeader();
	window.addEventListener('scroll', updateHeader, { passive: true });
</script>
